# Public site URL (required for production canonical URLs, sitemap and robots)
NEXT_PUBLIC_SITE_URL=https://example.com

# Client-verified contact destinations
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ENQUIRY_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Server-side enquiry destination. Example: a private webhook/automation endpoint.
# Do not expose this value with NEXT_PUBLIC_.
ENQUIRY_WEBHOOK_URL=
